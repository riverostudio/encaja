# Sin esto Vercel hereda .gitignore, que excluye data/ entera, y la funcion
# arranca sin base: SQLITE_CANTOPEN.
/expedientes/
docs/
tests/
web/
.env.local
data/*
!data/radar-publico.db
# Si una tarea dejó cambios pendientes en WAL, el prebuild necesita estos
# auxiliares para consolidarlos antes de empaquetar la base en modo DELETE.
!data/radar-publico.db-wal
!data/radar-publico.db-shm
